{
  "name": "ride_lifecycle",
  "actors": [
    "rider",
    "system",
    "driver"
  ],
  "nodes": [
    {
      "id": "quote_requested",
      "type": "start",
      "actor": "rider",
      "label": "Request quote",
      "outputs": [
        "pickup_location",
        "dropoff_location"
      ]
    },
    {
      "id": "quote_generated",
      "type": "process",
      "actor": "system",
      "label": "Calculate distance, ETA, price",
      "inputs": [
        "pickup_location",
        "dropoff_location",
        "nearest_available_driver"
      ],
      "outputs": [
        "quote"
      ]
    },
    {
      "id": "rider_decides",
      "type": "decision",
      "actor": "rider",
      "label": "Accept quote?"
    },
    {
      "id": "order_pending",
      "type": "state",
      "actor": "system",
      "label": "Order pending",
      "timeout": {
        "ticks": null,
        "on_timeout": "order_cancelled"
      },
      "outputs": [
        "order"
      ]
    },
    {
      "id": "driver_decides",
      "type": "decision",
      "actor": "driver",
      "label": "Accept order?",
      "timeout": {
        "ticks": null,
        "on_timeout": "next_driver"
      }
    },
    {
      "id": "en_route_to_pickup",
      "type": "state",
      "actor": "driver",
      "label": "Driving to pickup"
    },
    {
      "id": "at_pickup",
      "type": "state",
      "actor": "driver",
      "label": "Waiting at pickup"
    },
    {
      "id": "en_route_to_dropoff",
      "type": "state",
      "actor": "driver",
      "label": "Driving to dropoff"
    },
    {
      "id": "order_completed",
      "type": "end",
      "actor": "system",
      "label": "Order completed"
    },
    {
      "id": "order_cancelled",
      "type": "end",
      "actor": "system",
      "label": "Order cancelled"
    }
  ],
  "edges": [
    {
      "from": "quote_requested",
      "to": "quote_generated",
      "event": "request_quote",
      "data": [
        "pickup_location",
        "dropoff_location"
      ]
    },
    {
      "from": "quote_generated",
      "to": "rider_decides",
      "event": "quote_ready",
      "data": [
        "quote"
      ]
    },
    {
      "from": "rider_decides",
      "to": "order_pending",
      "event": "accept",
      "data": [
        "quote"
      ]
    },
    {
      "from": "rider_decides",
      "to": "quote_requested",
      "event": "reject"
    },
    {
      "from": "order_pending",
      "to": "driver_decides",
      "event": "offer",
      "action": "nearest available driver",
      "data": [
        "order"
      ]
    },
    {
      "from": "order_pending",
      "to": "order_cancelled",
      "event": "timeout"
    },
    {
      "from": "driver_decides",
      "to": "en_route_to_pickup",
      "event": "accept",
      "data": [
        "order",
        "driver"
      ]
    },
    {
      "from": "driver_decides",
      "to": "driver_decides",
      "event": "reject",
      "guard": "drivers left"
    },
    {
      "from": "driver_decides",
      "to": "order_cancelled",
      "event": "reject",
      "guard": "all rejected"
    },
    {
      "from": "en_route_to_pickup",
      "to": "at_pickup",
      "event": "arrive",
      "data": [
        "driver_location"
      ]
    },
    {
      "from": "at_pickup",
      "to": "en_route_to_dropoff",
      "event": "rider_in"
    },
    {
      "from": "en_route_to_dropoff",
      "to": "order_completed",
      "event": "arrive",
      "data": [
        "order"
      ]
    }
  ]
}